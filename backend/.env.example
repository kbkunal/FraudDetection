# Database: Local SQLite or Cloud PostgreSQL (Render / Supabase / Neon)
# Local SQLite default:
DATABASE_URL=sqlite:///./cybershield.db
# Cloud PostgreSQL example:
# DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Security: JWT Secret key (generate a random 64-character secret in production)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Limits
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Environment: "development" or "production"
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated URLs or JSON array)
# In production on Render, include your Vercel deployment domain:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
